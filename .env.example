# Copy to .env and fill in. Real environment variables win over this file.
# Never commit .env.

# --- Required in production -------------------------------------------------

# Signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Production refuses to start without one of at least 32 characters.
SECRET_KEY=

# Leave blank: gunicorn then runs config.ProdConfig and `python run.py` runs
# config.DevConfig. Set it only to override that.
BUNKK_CONFIG=

# Where the ledger lives. A relative SQLite path is resolved against the
# repository, so this is <repo>/instance/bunkk.db. Use an absolute path
# (sqlite:////var/lib/bunkk/bunkk.db) to keep data outside the checkout.
DATABASE_URL=sqlite:///instance/bunkk.db

# Google sign-in, the only way in. Create an OAuth client in Google Cloud
# Console (README, "Google sign-in") with this redirect URI:
#   https://<your host>/auth/google/callback
#   (dev: http://localhost:5000/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated hostnames this app answers for, e.g. bunkk.example.com.
# Any other Host header is refused, which is what keeps the OAuth redirect
# URL honest.
BUNKK_TRUSTED_HOSTS=

# --- Optional ---------------------------------------------------------------

# The college's timezone (IANA name). "Today" is worked out in this zone
# whatever the server's own clock is set to. Defaults to Asia/Kolkata.
BUNKK_TIMEZONE=Asia/Kolkata

# Where uploaded PDFs are kept. Relative paths are resolved against the
# repository. Must be on a disk that survives a redeploy.
BUNKK_UPLOAD_DIR=instance/uploads

# Set to 0 only if gunicorn is exposed directly with no reverse proxy.
BUNKK_BEHIND_PROXY=1

# Rate-limit counters. memory:// is per process; use redis://host:6379 when
# running more than one gunicorn worker so the limits are shared.
RATELIMIT_STORAGE_URI=memory://

# gunicorn (gunicorn.conf.py). The defaults suit one small server behind a
# reverse proxy on the same machine.
BUNKK_BIND=127.0.0.1:8000
WEB_CONCURRENCY=
BUNKK_THREADS=4
FORWARDED_ALLOW_IPS=127.0.0.1

# Dev only: set to 1 to get /login/dev, which signs in as any typed address
# without Google. Ignored unless the app runs in debug mode.
BUNKK_DEV_LOGIN=0

# Usage stats. Comma-separated Google addresses allowed to open /admin/stats.
# Leave empty to switch the page off; `flask stats` prints the same figures.
BUNKK_ADMIN_EMAILS=
