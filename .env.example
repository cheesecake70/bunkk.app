# Flask / app configuration
SECRET_KEY=dev-secret-key-change-in-production
BUNKR_CONFIG=config.DevConfig
DATABASE_URL=sqlite:///instance/bunkr.db
BUNKR_UPLOAD_DIR=instance/uploads

# Production only. Comma-separated hostnames this app answers for; any other
# Host header is refused (this is what keeps password-reset links honest).
BUNKR_TRUSTED_HOSTS=bunkr.example.com
# Set to 0 only if gunicorn is exposed directly with no reverse proxy.
BUNKR_BEHIND_PROXY=1

# Rate limiting. memory:// is per process; use redis://host:6379 when running
# more than one gunicorn worker.
RATELIMIT_STORAGE_URI=memory://

# Password-reset email. Required in production. Without MAIL_SERVER the reset
# link is written to the log instead of sent, which is all a single-machine
# dev setup needs.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_DEFAULT_SENDER=Bunkr <no-reply@example.com>
