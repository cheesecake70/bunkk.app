# Flask / app configuration
SECRET_KEY=dev-secret-key-change-in-production
BUNKK_CONFIG=config.DevConfig
DATABASE_URL=sqlite:///instance/bunkk.db
BUNKK_UPLOAD_DIR=instance/uploads

# Production only. Comma-separated hostnames this app answers for; any other
# Host header is refused (this is what keeps the OAuth redirect URL honest).
BUNKK_TRUSTED_HOSTS=bunkk.example.com
# Set to 0 only if gunicorn is exposed directly with no reverse proxy.
BUNKK_BEHIND_PROXY=1

# Rate limiting. memory:// is per process; use redis://host:6379 when running
# more than one gunicorn worker.
RATELIMIT_STORAGE_URI=memory://

# Google sign-in — the only way in. Create an OAuth client in Google Cloud
# Console (README, "Google sign-in") with this redirect URI:
#   https://<your host>/auth/google/callback   (dev: http://localhost:5000/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev only: set to 1 to get /login/dev, which signs in as any typed address
# without Google. Ignored unless the app runs in debug mode.
BUNKK_DEV_LOGIN=0
