# systemd unit for Bunkk. Copy to /etc/systemd/system/bunkk.service, adjust
# User and the two paths, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now bunkk
#
# Configuration comes from /srv/bunkk/.env (see .env.example); gunicorn.conf.py
# reads it, so nothing secret needs to appear in this file.
[Unit]
Description=Bunkk (gunicorn)
After=network.target

[Service]
User=bunkk
Group=bunkk
WorkingDirectory=/srv/bunkk
# Explicit, so the migration step runs under the same config as the server.
Environment=BUNKK_CONFIG=config.ProdConfig
ExecStartPre=/srv/bunkk/.venv/bin/flask db upgrade
ExecStart=/srv/bunkk/.venv/bin/gunicorn -c gunicorn.conf.py run:app
Restart=on-failure
RestartSec=3
# The app only ever writes to instance/ (the database and uploaded PDFs).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
